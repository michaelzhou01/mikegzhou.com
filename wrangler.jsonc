{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikegzhou",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "mikegzhou.com", "custom_domain": true },
    { "pattern": "www.mikegzhou.com", "custom_domain": true }
  ]
}
